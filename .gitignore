# Public release allowlist: keep the repository focused on paper code.
/*
!/.gitignore
!/README.md
!/requirements.txt

!/assets/
/assets/*
!/assets/method.jpg
!/assets/compare_all_regions_temp.jpg
!/assets/compare_all_regions_ppt.jpg

!/dataset/
/dataset/*
!/dataset/__init__.py
!/dataset/temporal_dataset.py

!/models/
/models/*
!/models/__init__.py
!/models/base/
/models/base/*
!/models/base/__init__.py
!/models/base/conv_blocks.py
!/models/base/conv_gru.py
!/models/driveguard_wm/
/models/driveguard_wm/*
!/models/driveguard_wm/*.py
/models/driveguard_wm/test_*.py

!/script/
/script/*
!/script/__init__.py
!/script/trainer_driveguard_wm.py
!/script/infer_driveguard_wm.py
!/script/run_e1_state_intervention.py
!/script/run_e2_matrix_validation.py
!/script/run_e3_dual_path_ablation.py
!/script/run_e4_controller.py
!/script/run_e4_calibration.py

# Never track generated or potentially large artifacts.
__pycache__/
*.py[cod]
*.pth
*.pt
*.ckpt
*.npy
*.npz
*.nc
*.nc4
*.h5
*.hdf5
*.zarr
*.log
.DS_Store
.idea/
.vscode/
.claude/
.venv/
venv/
outputs/
results/
data/
